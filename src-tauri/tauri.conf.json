{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warm CRM",
  "version": "0.1.0",
  "identifier": "local.warmcrm.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://127.0.0.1:3333",
    "frontendDist": "../dist/client"
  },
  "app": {
    "windows": [
      {
        "title": "Warm CRM — Personal Relationship Companion",
        "width": 1240,
        "height": 840,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:3333 http://localhost:3333; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
